# Diwali Crackers needs NO secrets or API keys.
# Everything runs in the visitor's browser: hand tracking (MediaPipe) loads from public CDNs,
# sounds are synthesized with the Web Audio API, and nothing is sent to any server.
#
# The only optional setting is for the local HTTPS server used to test on a phone over Wi-Fi:

# Port for `python serve-https.py` (default 8443)
HTTPS_PORT=8443
